# --- Supabase Postgres connection ---
SUPABASE_DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# --- Supabase Auth (optional, used if using Supabase auth) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# --- JWT Secret for self-contained auth ---
JWT_SECRET=hirelens-jwt-secret-key-that-is-long-enough-for-hmac-sha256-algorithm-change-in-production
JWT_EXPIRATION_MS=86400000

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- CORS: your frontend's origin ---
FRONTEND_URL=http://localhost:3000

# Optional: override default port
PORT=8080
