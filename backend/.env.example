# --- Supabase Postgres connection (REQUIRED) ---
# Put the credentials in the separate *_USER / *_PASSWORD variables, NOT inline in the URL.
# An inline "jdbc:postgresql://user:pass@host/db" form makes the Postgres driver mis-split the
# authority and fail DNS resolution on a "hostname" that actually contains your password
# (you get "The connection attempt failed" / UnknownHostException, not an auth error).
# The driver also percent-decodes, so an unencoded "@" in the password breaks parsing.
# Spring Boot reads url / username / password independently, which is what we want here.
#
# The jdbc: prefix is mandatory - a bare postgresql:// URL aborts startup with
# "URL must start with 'jdbc'".
#
# Host/port/database below are placeholders - copy your own from
# Supabase -> Project Settings -> Database -> Connection string (the URI tab, port 5432).
# Use the pooler (port 6543) if direct connections are blocked for your network.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
# Reset this in Supabase -> Project Settings -> Database if you don't have it.
SUPABASE_DB_PASSWORD=

# --- Supabase Auth (OPTIONAL - only if you switch from the built-in auth) ---
# The backend ships with self-contained auth (BCrypt + its own JWT), so these can stay blank.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- JWT for the self-contained auth (REQUIRED in production) ---
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-before-deploying-anything
JWT_EXPIRATION_MS=86400000

# --- Ollama (local LLM + embeddings) ---
# All of these have working defaults for a local daemon at http://localhost:11434,
# so you normally do NOT need to set them. Listed here for reference / overrides.
# No API key is required for a local Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# MUST match the pgvector column width in supabase/schema.sql
# (nomic-embed-text -> 768, mxbai-embed-large -> 1024, bge-m3 -> 1024)
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Raise these on CPU-only inference
OLLAMA_CHAT_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
# Ollama defaults to 4096, which truncates long job descriptions
OLLAMA_NUM_CTX=8192
# Constrains the chat model to valid JSON. Turn off for weaker models.
OLLAMA_JSON_MODE=true

# --- CORS: the exact origin your frontend is served from ---
# Must match frontend/vite.config.ts (which pins the dev server to 3000).
FRONTEND_URL=http://localhost:3000

# Optional: override default port
PORT=8080
